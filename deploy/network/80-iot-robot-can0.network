# systemd-networkd: bring up can0 at 1 Mbit/s whenever it appears.
#
# Works for adapters with a native SocketCAN driver (gs_usb/candleLight, PEAK,
# usb_8dev) and SPI CAN HATs. networkd configures the link each time the interface
# appears, so a USB adapter plugged in after boot is set up too.
#
# slcan adapters cannot be configured here: their bitrate is set by slcand, not
# over netlink. Use `deploy/scripts/can_up.sh --slcan <tty>` for those (see
# deploy/README.md).
#
# networkd only touches links that match a .network file, so it coexists with
# NetworkManager, which keeps managing Wi-Fi and Ethernet.

[Match]
Name=can0

[Link]
# A CAN link carries no IP traffic; never hold up network-online.target on it.
RequiredForOnline=no

[CAN]
BitRate=1M
# No RestartSec= (automatic bus-off restart): the gs_usb driver rejects it with
# "Device doesn't support restart from Bus Off", and networkd then leaves can0 down
# for good. After a bus-off (e.g. a motor powered on mid-frame) run
# `sudo deploy/scripts/can_up.sh`, which enables the restart where the driver
# supports it.
