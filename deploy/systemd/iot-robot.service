# Starts the real robot (robot.launch.py) at boot. Template: deploy/install.sh fills in
# @USER@, @REPO@ and @PIXI@ and installs it as /etc/systemd/system/iot-robot.service.
#
#   sudo systemctl start|stop|restart iot-robot
#   journalctl -u iot-robot -f
#
# Launch arguments and ROS settings live in /etc/default/iot-robot.

[Unit]
Description=iot_robot ROS 2 bringup (CAN motors, camera, STM32 bridge, IMU, web UI)
Documentation=file://@REPO@/docs/hardware.md
# can0 is configured by systemd-networkd. There is no hard dependency on the adapter:
# if it or the motors are missing, the launch's CAN pre-flight check fails and the
# service retries below until they appear.
After=network.target systemd-networkd.service
# Retry forever; the motors are often powered on after the Pi
StartLimitIntervalSec=0

[Service]
Type=exec
User=@USER@
WorkingDirectory=@REPO@
# Default for the motor stop below; /etc/default/iot-robot overrides it
Environment=IOT_CAN_INTERFACE=can0
EnvironmentFile=-/etc/default/iot-robot
# --frozen installs exactly what pixi.lock says without re-solving, so a boot never
# waits on the network or silently changes package versions.
# $IOT_ROBOT_ARGS is split at whitespace into separate launch arguments.
ExecStart=@PIXI@ run --frozen -e robot robot $IOT_ROBOT_ARGS
# After every stop, crash or kill of the robot: zero speed, then release, to every
# motor. robot.launch.py does the same when ros2_control_node exits; this also covers
# the launch itself being killed. The IDs are those in motors.yaml plus any motor heard
# on the bus. It does nothing when the CAN link is not up.
ExecStopPost=@PIXI@ run --frozen -e robot ros2 run iot_robot_drivers cubemars_tool --interface ${IOT_CAN_INTERFACE} stop
Restart=always
RestartSec=5
# Lets controller_manager run its 50 Hz loop with SCHED_FIFO, which cuts timing jitter
# on a loaded Pi. Without it the node logs "Could not enable FIFO RT scheduling policy"
# and runs with normal priority.
LimitRTPRIO=99
# ros2 launch shuts its nodes down cleanly on SIGINT (Ctrl-C) and forwards the signal
# to every node itself. mixed sends SIGINT to the main process only, so the nodes are
# not interrupted twice; whatever is still running after the timeout gets SIGKILL.
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
