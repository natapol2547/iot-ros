# Settings for iot-robot.service, installed as /etc/default/iot-robot.
# Apply changes with: sudo systemctl restart iot-robot

# Laptop tools (RViz, rqt, teleop, camera calibration) must use the same domain.
ROS_DOMAIN_ID=0

# Extra arguments for robot.launch.py, separated by spaces. List them with
#   pixi run -e robot ros2 launch iot_robot_bringup robot.launch.py --show-args
# Examples: gizmo_mode:=fixed   camera:=false   web:=false   imu:=false   check_can:=false
#
# The motor CAN IDs and directions are not launch arguments: they live in
# src/iot_robot_bringup/config/motors.yaml (docs/todo.md). To use another file, pass
# its absolute path, e.g. motors:=/home/pi/motors.yaml. The stop step below still reads
# the package's motors.yaml, but it also stops every motor it hears on the bus.
IOT_ROBOT_ARGS=

# Where the service sends zero speed and release after the robot stops. Keep it in
# step with can_interface if IOT_ROBOT_ARGS changes it.
#IOT_CAN_INTERFACE=can0
