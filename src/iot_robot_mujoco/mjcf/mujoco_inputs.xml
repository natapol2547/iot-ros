<mujoco_inputs>
    <!-- Copied verbatim into the generated MJCF -->
    <raw_inputs>
        <option integrator="implicitfast" />

        <!-- The converter tags every geom with class="visual" or class="collision";
         MuJoCo refuses to load the model unless those classes exist. -->
        <default>
            <default class="visual">
                <geom group="2" contype="0" conaffinity="0" />
            </default>
            <default class="collision">
                <geom group="3" />
            </default>
        </default>

        <actuator>
            <!-- AK45-10: 7 N·m peak torque, 180 rpm (19 rad/s) output speed -->
            <velocity name="wheel_joint_left" joint="wheel_joint_left" kv="1.0" ctrlrange="-19 19"
                forcerange="-7 7" />
            <velocity name="wheel_joint_right" joint="wheel_joint_right" kv="1.0" ctrlrange="-19 19"
                forcerange="-7 7" />
            <!-- Placeholder gains, not yet matched to the AK45-10 gizmo motors -->
            <position name="gizmo_yaw_joint" joint="gizmo_yaw_joint" kp="5" dampratio="1"
                ctrlrange="-0.785398 0.785398" />
            <position name="gizmo_pitch_joint" joint="gizmo_pitch_joint" kp="5" dampratio="1"
                ctrlrange="-0.785398 0" />
        </actuator>

        <!-- One rangefinder per ultrasonic ray. The <lidar> tags below replicate the sites into
         ultrasonic_left-0 ... -4, and MuJoCo replicates a sensor that references a replicated
         site, so these become ten rangefinders with the same names -->
        <sensor>
            <rangefinder name="ultrasonic_left" site="ultrasonic_left" />
            <rangefinder name="ultrasonic_right" site="ultrasonic_right" />
        </sensor>
    </raw_inputs>

    <!-- Tags the converter transforms before inserting -->
    <processed_inputs>
        <!-- Lift both casters 2 mm so the wheels carry the weight; casters only catch pitching -->
        <modify_element type="body" name="caster_front" pos="0.141 0 0.002" />
        <modify_element type="body" name="caster_back" pos="-0.141001 0 0.002126" />

        <!-- Raspberry Pi Camera v2.1 (IMX219): 48.8° vertical FOV -->
        <camera site="camera_optical_frame" name="camera" fovy="48.8" mode="fixed"
            resolution="640 480" />

        <!-- HC-SR04 beam: five horizontal rays across its ~15° cone (±0.13 rad around the
         sensor's x axis). The sim turns the resulting LaserScan into sensor_msgs/Range by taking
         the nearest ray. max_angle is a hair over 0.13 so the converter's
         int((max - min) / increment) + 1 is 5 despite floating point rounding -->
        <lidar ref_site="ultrasonic_left_link" sensor_name="ultrasonic_left" min_angle="-0.13"
            max_angle="0.1301" angle_increment="0.065" />
        <lidar ref_site="ultrasonic_right_link" sensor_name="ultrasonic_right" min_angle="-0.13"
            max_angle="0.1301" angle_increment="0.065" />
    </processed_inputs>
</mujoco_inputs>