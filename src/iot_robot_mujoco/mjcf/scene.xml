<mujoco model="iot_robot_scene">
    <!-- Generated by `pixi run mjcf`; do not edit that file by hand -->
    <include file="mujoco_description_formatted.xml" />

    <statistic center="0 0 0.2" extent="1.5" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <global azimuth="160" elevation="-25" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
            rgb2="0.1 0.2 0.3"
            markrgb="0.8 0.8 0.8" width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" />
        <material name="skin" rgba="0.87 0.67 0.53 1" />
        <material name="shirt" rgba="0.75 0.2 0.15 1" />
        <material name="pants" rgba="0.2 0.25 0.4 1" />
        <material name="shoes" rgba="0.1 0.1 0.1 1" />
        <material name="hair" rgba="0.15 0.1 0.05 1" />
        <material name="eyes" rgba="0.05 0.05 0.05 1" />
        <material name="shirt2" rgba="0.2 0.55 0.3 1" />
        <material name="pants2" rgba="0.65 0.55 0.4 1" />

    </asset>

    <worldbody>
        <light pos="0 0 3" dir="0 0 -1" directional="true" />
        <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" />

        <!-- 10 cm yellow ball, 1 m in front of the robot -->
        <body name="ball" pos="1.0 0 0.05">
            <freejoint name="ball_joint" />
            <geom name="ball" type="sphere" size="0.05" mass="0.06" rgba="1 0.85 0 1" />
        </body>
        <!-- 1.70 m mannequin that YOLO recognises as a person. The slide and hinge joints keep
         it upright; move it in the viewer with Ctrl + Shift + right-drag. The damping stops it
         gliding away after you let go -->
        <body name="person" pos="2.5 0 0.002" euler="0 0 3.14159">
            <joint name="person_x" type="slide" axis="1 0 0" damping="300" />
            <joint name="person_y" type="slide" axis="0 1 0" damping="300" />
            <joint name="person_yaw" type="hinge" axis="0 0 1" damping="30" />
            <!-- Legs and shoes -->
            <geom type="capsule" fromto="0 -0.10 0.10 0.02 -0.11 0.48" size="0.055" material="pants" />
            <geom type="capsule" fromto="0.02 -0.11 0.48 0 -0.10 0.88" size="0.065" material="pants" />
            <geom type="capsule" fromto="0 0.10 0.10 0.02 0.11 0.48" size="0.055" material="pants" />
            <geom type="capsule" fromto="0.02 0.11 0.48 0 0.10 0.88" size="0.065" material="pants" />
            <geom type="box" pos="0.05 -0.10 0.04" size="0.13 0.05 0.04" material="shoes" />
            <geom type="box" pos="0.05 0.10 0.04" size="0.13 0.05 0.04" material="shoes" />
            <!-- Hips, torso, shoulders -->
            <geom type="capsule" fromto="0 -0.10 0.92 0 0.10 0.92" size="0.09" material="pants" />
            <geom type="box" pos="0 0 1.15" size="0.10 0.17 0.20" material="shirt" />
            <geom type="capsule" fromto="0 -0.14 1.38 0 0.14 1.38" size="0.07" material="shirt" />
            <!-- Arms: sleeve, then forearm -->
            <geom type="capsule" fromto="0 -0.22 1.38 0 -0.27 1.10" size="0.045" material="shirt" />
            <geom type="capsule" fromto="0 -0.27 1.10 0.05 -0.29 0.86" size="0.038" material="skin" />
            <geom type="capsule" fromto="0 0.22 1.38 0 0.27 1.10" size="0.045" material="shirt" />
            <geom type="capsule" fromto="0 0.27 1.10 0.05 0.29 0.86" size="0.038" material="skin" />
            <!-- Neck, head, hair -->
            <geom type="capsule" fromto="0 0 1.42 0 0 1.50" size="0.045" material="skin" />
            <geom type="ellipsoid" pos="0.01 0 1.59" size="0.095 0.08 0.11" material="skin" />
            <geom type="ellipsoid" pos="-0.01 0 1.64" size="0.095 0.085 0.075" material="hair" />
            <!-- Face: without it YOLO barely detects the mannequin from the front -->
            <geom type="sphere" pos="0.088 -0.035 1.61" size="0.013" material="eyes" />
            <geom type="sphere" pos="0.088 0.035 1.61" size="0.013" material="eyes" />
            <geom type="sphere" pos="0.105 0 1.575" size="0.018" material="skin" />
        </body>

        <!-- A second mannequin in different clothes, for testing re-identification -->
        <body name="person2" pos="2.0 -0.9 0.002" euler="0 0 3.14159">
            <joint name="person2_x" type="slide" axis="1 0 0" damping="300" />
            <joint name="person2_y" type="slide" axis="0 1 0" damping="300" />
            <joint name="person2_yaw" type="hinge" axis="0 0 1" damping="30" />
            <!-- Legs and shoes -->
            <geom type="capsule" fromto="0 -0.10 0.10 0.02 -0.11 0.48" size="0.055" material="pants2" />
            <geom type="capsule" fromto="0.02 -0.11 0.48 0 -0.10 0.88" size="0.065" material="pants2" />
            <geom type="capsule" fromto="0 0.10 0.10 0.02 0.11 0.48" size="0.055" material="pants2" />
            <geom type="capsule" fromto="0.02 0.11 0.48 0 0.10 0.88" size="0.065" material="pants2" />
            <geom type="box" pos="0.05 -0.10 0.04" size="0.13 0.05 0.04" material="shoes" />
            <geom type="box" pos="0.05 0.10 0.04" size="0.13 0.05 0.04" material="shoes" />
            <!-- Hips, torso, shoulders -->
            <geom type="capsule" fromto="0 -0.10 0.92 0 0.10 0.92" size="0.09" material="pants2" />
            <geom type="box" pos="0 0 1.15" size="0.10 0.17 0.20" material="shirt2" />
            <geom type="capsule" fromto="0 -0.14 1.38 0 0.14 1.38" size="0.07" material="shirt2" />
            <!-- Arms: sleeve, then forearm -->
            <geom type="capsule" fromto="0 -0.22 1.38 0 -0.27 1.10" size="0.045" material="shirt2" />
            <geom type="capsule" fromto="0 -0.27 1.10 0.05 -0.29 0.86" size="0.038" material="skin" />
            <geom type="capsule" fromto="0 0.22 1.38 0 0.27 1.10" size="0.045" material="shirt2" />
            <geom type="capsule" fromto="0 0.27 1.10 0.05 0.29 0.86" size="0.038" material="skin" />
            <!-- Neck, head, hair, face -->
            <geom type="capsule" fromto="0 0 1.42 0 0 1.50" size="0.045" material="skin" />
            <geom type="ellipsoid" pos="0.01 0 1.59" size="0.095 0.08 0.11" material="skin" />
            <geom type="ellipsoid" pos="-0.01 0 1.64" size="0.095 0.085 0.075" material="hair" />
            <geom type="sphere" pos="0.088 -0.035 1.61" size="0.013" material="eyes" />
            <geom type="sphere" pos="0.088 0.035 1.61" size="0.013" material="eyes" />
            <geom type="sphere" pos="0.105 0 1.575" size="0.018" material="skin" />
        </body>

    </worldbody>
</mujoco>