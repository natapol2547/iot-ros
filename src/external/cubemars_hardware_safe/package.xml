<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>cubemars_hardware_safe</name>
    <version>0.1.0</version>
    <description>
        Safety layer for the upstream cubemars_hardware ros2_control plugin: stops the
        motors whenever the hardware component stops, and stops both wheels when a motor
        reports a fault or goes silent.
    </description>
    <maintainer email="contact@findmy3d.com">tawan</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <depend>cubemars_hardware</depend>
    <depend>hardware_interface</depend>
    <depend>pluginlib</depend>
    <depend>rclcpp</depend>
    <depend>rclcpp_lifecycle</depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
